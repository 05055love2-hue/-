<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="10dp"
    android:layoutDirection="rtl" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="22sp" android:text="🏛️" />
    <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#ffffff" android:textSize="40sp" android:textStyle="bold" android:includeFontPadding="false" android:text="11" />
    <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#ccffffff" android:textSize="11sp" android:text="يوم" />
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="#6ee7b7" android:textSize="13sp" android:textStyle="bold"
        android:maxLines="1" android:text="راتب الدولة" />
</LinearLayout>
