<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:layoutDirection="rtl"
    android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="30sp" android:text="🏛️" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#aaffffff" android:textSize="11sp" android:text="أقرب صرف" />
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#ffffff" android:textSize="18sp" android:textStyle="bold" android:text="راتب الدولة" />
            <TextView android:id="@+id/star" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#ccffffff" android:textSize="12sp" android:text="الخميس 26 نوفمبر" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/days_bg"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#ffffff" android:textSize="24sp" android:textStyle="bold" android:text="11" />
            <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#ccffffff" android:textSize="11sp" android:text="يوم" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/r0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#d1fae5" android:textSize="13sp" android:maxLines="1" android:text="" />
    <TextView android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#dbeafe" android:textSize="13sp" android:maxLines="1" android:text="" />
    <TextView android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#fef3c7" android:textSize="13sp" android:maxLines="1" android:text="" />
</LinearLayout>
