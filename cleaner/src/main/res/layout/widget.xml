<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp"
    android:layoutDirection="rtl" android:background="@drawable/w_bg">
    <ImageView android:id="@+id/ring" android:layout_width="78dp" android:layout_height="78dp"
        android:scaleType="fitCenter" android:contentDescription="المساحة" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🧹 منظّف" android:textColor="#ffffff" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/free" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="فاضي —" android:textColor="#f0ffffff" android:textSize="13sp" android:maxLines="1" />
        <TextView android:id="@+id/last" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ما نظّفت للحين" android:textColor="#ccffffff" android:textSize="11.5sp" android:maxLines="2" />
        <TextView android:id="@+id/btn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:background="@drawable/w_btn" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="6dp" android:paddingBottom="6dp" android:text="🧹 نظّف الحين" android:textColor="#0f766e"
            android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
