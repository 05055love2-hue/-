<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bgimg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w7r3"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:layoutDirection="rtl">
        <LinearLayout android:id="@+id/info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:paddingStart="8dp" android:paddingEnd="4dp">
            <LinearLayout android:id="@+id/row1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="rtl">
                <ImageView android:id="@+id/ic1" android:layout_width="26dp" android:layout_height="26dp" android:padding="4dp" android:src="@drawable/ic_moon" android:background="@drawable/w7_dot"/>
                <TextView android:id="@+id/hijri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#111111" android:textSize="15sp" android:maxLines="1" android:text="اثنين، 26 جمادى الأولى"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/row2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="rtl">
                <ImageView android:id="@+id/ic2" android:layout_width="26dp" android:layout_height="26dp" android:padding="4dp" android:src="@drawable/ic_pin" android:background="@drawable/w7_dot"/>
                <TextView android:id="@+id/city" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#111111" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:text="الرياض"/>
            </LinearLayout>
        </LinearLayout>
        <Chronometer android:id="@+id/cd" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="#111111" android:textSize="18sp" android:maxLines="1"/>
        <FrameLayout android:id="@+id/box" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="74dp">
            <ImageView android:id="@+id/boximg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w7b3"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp">
                <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#ffffff" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="العشاء"/>
                <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#ffffff" android:textSize="19sp" android:textStyle="bold" android:maxLines="1" android:text="6:37"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
